# Staging-only gateway configuration. Never commit .env.staging.
PORT=8080
AI_GATEWAY_TOKEN=replace-with-random-internal-token
AI_GATEWAY_USER_SALT=replace-with-random-private-salt
GROQ_API_KEY=replace-me
GROQ_MODEL=replace-with-approved-groq-model
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_GATEWAY_RATE_LIMIT_PER_MINUTE=5
AI_GATEWAY_DAILY_QUOTA=30
AI_GATEWAY_MAX_CONCURRENCY=2
AI_GATEWAY_TIMEOUT_MS=30000
AI_GATEWAY_STATE_STORE=memory
