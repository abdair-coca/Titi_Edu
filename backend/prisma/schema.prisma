// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ESTUDIANTE
  PROFESOR
  ADMIN
}

enum TipoPregunta {
  OPCION_MULTIPLE
  VERDADERO_FALSO
  RESPUESTA_CORTA
}

enum EstadoModulo {
  BORRADOR
  PUBLICADO
}

enum EstadoLeccion {
  BORRADOR
  PUBLICADA
  ARCHIVADA
}

enum FormatoContenido {
  TEXTO
  MARKDOWN
  HTML
}

enum EstadoOperacionAutoria {
  PENDIENTE
  COMPLETADA
  FALLIDA
}

model Usuario {
  id       String @id @default(uuid())
  neoId    String @unique
  username String @unique
  email    String @unique

  rol             Rol       @default(ESTUDIANTE)
  verificado      Boolean   @default(false)
  racha           Int       @default(0)
  ultimaActividad DateTime?
  createdAt       DateTime  @default(now())

  // Etapa 6 — gotas (XP). gotasSaldo es gastable (acumula, sin tienda aún);
  // gotasTotal es lifetime (alimenta ranking histórico y futuros niveles).
  gotasSaldo Int @default(0)
  gotasTotal Int @default(0)

  // Etapa 7 — tienda. x2 gotas activo hasta este instante (multiplicador_gotas).
  gotasMultiplicadorHasta DateTime?

  cursosCreados      Curso[]         @relation("CursosCreados")
  cursosComoProfesor CursoProfesor[]

  inscripciones      Inscripcion[]
  progresos          Progreso[]
  intentos           Intento[]
  logros             LogroUsuario[]
  certificados       Certificado[]
  notas              NotaLeccion[]
  intentosHtml       IntentoHtmlLeccion[]
  resultadosHtml     ResultadoHtmlLeccion[]
  movimientosGota    MovimientoGota[]
  misionesUsuario    MisionUsuario[]
  insignias          InsigniaSemanal[]
  comprasItem        CompraItem[]
  inventario         InventarioItem[]
  tokensServicio     TokenServicio[]
  operacionesAutoria OperacionAutoria[]
  revisionesLeccion  RevisionLeccion[]
}

// Etapa 6 — catálogo de misiones diarias. Se siembran en seed.js (idempotente por codigo).
model Mision {
  id           String          @id @default(uuid())
  codigo       String          @unique
  titulo       String
  descripcion  String
  evento       String // qué evento la avanza: 'leccion'|'evaluacion'|'post'|'comentario'|'follow'
  meta         Int // cuántas veces hay que hacer la acción
  recompensa   Int // gotas al completar
  activa       Boolean         @default(true)
  asignaciones MisionUsuario[]
}

// Etapa 6 — misión asignada a un usuario en un día concreto.
model MisionUsuario {
  id         String  @id @default(uuid())
  usuarioId  String
  misionId   String
  fecha      String // 'YYYY-MM-DD' del día asignado (TZ server)
  progreso   Int     @default(0)
  completada Boolean @default(false)
  usuario    Usuario @relation(fields: [usuarioId], references: [id])
  mision     Mision  @relation(fields: [misionId], references: [id])

  @@unique([usuarioId, misionId, fecha])
  @@index([usuarioId, fecha])
}

// Etapa 6 — premio al top del ranking de amigos de una semana. La semana se
// identifica por la fecha del lunes ('YYYY-MM-DD'). Unique por (usuario, semana)
// → el premio se otorga una sola vez por semana (idempotente).
model InsigniaSemanal {
  id          String   @id @default(uuid())
  usuarioId   String
  semana      String // lunes de la semana, 'YYYY-MM-DD'
  puesto      Int
  gotasSemana Int
  createdAt   DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, semana])
}

// Etapa 6 — ledger de gotas. Fuente de verdad para auditar y sumar por semana.
model MovimientoGota {
  id        String   @id @default(uuid())
  usuarioId String
  cantidad  Int // > 0 ganancia; < 0 gasto (Etapa 7 — 'compra_tienda')
  motivo    String // 'leccion'|'evaluacion'|'curso'|'mision'|'social_*'|'ranking_semanal'|'compra_tienda'
  refId     String? // id de lección/evaluación/post/item — auditoría + idempotencia
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
}

// Etapa 7 — catálogo de ítems consumibles de la tienda. Se siembran en seed.js
// (idempotente por codigo). El precio se paga en gotas (gotasSaldo).
model ItemTienda {
  id          String           @id @default(uuid())
  codigo      String           @unique // 'congelar_racha'|'intento_extra'|'multiplicador_gotas'
  nombre      String
  descripcion String
  precio      Int // en gotas
  efecto      String // qué hace al consumirse (mismo set que codigo)
  icono       String?
  limiteStack Int? // tope de acumulación por usuario (null = sin tope)
  activo      Boolean          @default(true)
  compras     CompraItem[]
  inventario  InventarioItem[]
}

// Etapa 7 — ledger de compras (auditoría). Cada compra debita gotas y suma 1 al inventario.
model CompraItem {
  id        String     @id @default(uuid())
  usuarioId String
  itemId    String
  precio    Int // snapshot del precio pagado
  createdAt DateTime   @default(now())
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  item      ItemTienda @relation(fields: [itemId], references: [id])

  @@index([usuarioId, createdAt])
}

// Etapa 7 — saldo de consumibles por usuario. Unique por (usuario, item).
model InventarioItem {
  id        String     @id @default(uuid())
  usuarioId String
  itemId    String
  cantidad  Int        @default(0)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  item      ItemTienda @relation(fields: [itemId], references: [id])

  @@unique([usuarioId, itemId])
}

model Categoria {
  id     String  @id @default(uuid())
  nombre String  @unique
  icono  String
  cursos Curso[]
}

model Curso {
  id               String   @id @default(uuid())
  titulo           String
  descripcion      String
  portadaUrl       String?
  nivel            String
  publicado        Boolean  @default(false)
  emiteCertificado Boolean  @default(true)
  version          Int      @default(0)
  createdAt        DateTime @default(now())

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  creadorId String
  creador   Usuario @relation("CursosCreados", fields: [creadorId], references: [id])

  profesores         CursoProfesor[]
  modulos            Modulo[]
  inscripciones      Inscripcion[]
  certificados       Certificado[]
  operacionesAutoria OperacionAutoria[]

  @@index([publicado, categoriaId])
}

model CursoProfesor {
  cursoId    String
  profesorId String
  curso      Curso   @relation(fields: [cursoId], references: [id])
  profesor   Usuario @relation(fields: [profesorId], references: [id])

  @@id([cursoId, profesorId])
}

model Modulo {
  id          String       @id @default(uuid())
  titulo      String
  descripcion String?
  orden       Int
  estado      EstadoModulo @default(BORRADOR)
  version     Int          @default(0)
  cursoId     String
  curso       Curso        @relation(fields: [cursoId], references: [id])
  lecciones   Leccion[]
  evaluacion  Evaluacion?
}

model Leccion {
  id               String              @id @default(uuid())
  titulo           String
  contenido        String // texto/descripción
  formatoContenido FormatoContenido    @default(TEXTO)
  videoUrl         String? // YouTube embed URL
  orden            Int
  estado           EstadoLeccion       @default(BORRADOR)
  publishedAt      DateTime?
  archivedAt       DateTime?
  version          Int                 @default(1)
  moduloId         String
  modulo           Modulo              @relation(fields: [moduloId], references: [id])
  materiales       Material[]
  progresos        Progreso[]
  comentarios      ComentarioLeccion[]
  notas            NotaLeccion[]
  recursoHtml      RecursoHtmlLeccion?
  revisiones       RevisionLeccion[]

  @@index([moduloId, estado, orden])
}

model RevisionLeccion {
  id        String   @id @default(uuid())
  leccionId String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  autorId   String
  leccion   Leccion  @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  autor     Usuario  @relation(fields: [autorId], references: [id])

  @@unique([leccionId, version])
  @@index([leccionId, createdAt])
}

model Material {
  id        String  @id @default(uuid())
  nombre    String
  url       String
  publicId  String? // public_id de Cloudinary (null para archivos legacy en disco)
  sha256    String?
  tipo      String // 'pdf' | 'word' | 'imagen' | 'codigo' | 'otro'
  leccionId String
  leccion   Leccion @relation(fields: [leccionId], references: [id])

  @@index([leccionId])
}

// Recurso HTML autocontenido por lección. El contenido se entrega exclusivamente
// como srcDoc dentro de un iframe sandboxed; nunca como URL pública.
model RecursoHtmlLeccion {
  id          String                 @id @default(uuid())
  leccionId   String                 @unique
  html        String
  evaluable   Boolean                @default(false)
  intentosMax Int?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  leccion     Leccion                @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  intentos    IntentoHtmlLeccion[]
  resultados  ResultadoHtmlLeccion[]

  @@index([leccionId])
}

// Cada inicio consume un intento. El token opaco vincula el postMessage al
// estudiante y hace idempotente la entrega del puntaje.
model IntentoHtmlLeccion {
  id            String                @id @default(uuid())
  token         String                @unique
  numero        Int
  puntaje       Float?
  resultadoAt   DateTime?
  createdAt     DateTime              @default(now())
  usuarioId     String
  recursoHtmlId String
  usuario       Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recursoHtml   RecursoHtmlLeccion    @relation(fields: [recursoHtmlId], references: [id], onDelete: Cascade)
  resultado     ResultadoHtmlLeccion?

  @@unique([usuarioId, recursoHtmlId, numero])
  @@index([usuarioId, recursoHtmlId])
}

// Mejor puntaje autodeclarado por estudiante y recurso HTML.
model ResultadoHtmlLeccion {
  id            String             @id @default(uuid())
  usuarioId     String
  recursoHtmlId String
  mejorPuntaje  Float
  intentoId     String
  updatedAt     DateTime           @updatedAt
  usuario       Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recursoHtml   RecursoHtmlLeccion @relation(fields: [recursoHtmlId], references: [id], onDelete: Cascade)
  intento       IntentoHtmlLeccion @relation(fields: [intentoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, recursoHtmlId])
  @@unique([intentoId])
  @@index([recursoHtmlId])
}

model TokenServicio {
  id         String    @id @default(uuid())
  nombre     String
  prefijo    String    @unique
  tokenHash  String    @unique
  scopes     String[]
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  usuarioId   String
  usuario     Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  operaciones OperacionAutoria[]

  @@index([usuarioId, revokedAt])
}

model OperacionAutoria {
  id                 String                 @id @default(uuid())
  actorKey           String
  idempotencyKey     String
  accion             String
  requestFingerprint String
  estado             EstadoOperacionAutoria @default(PENDIENTE)
  httpStatus         Int?
  response           Json?
  contexto           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  usuarioId       String?
  usuario         Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  cursoId         String?
  curso           Curso?         @relation(fields: [cursoId], references: [id], onDelete: SetNull)
  tokenServicioId String?
  tokenServicio   TokenServicio? @relation(fields: [tokenServicioId], references: [id], onDelete: SetNull)

  @@unique([actorKey, idempotencyKey])
  @@index([cursoId, createdAt])
  @@index([tokenServicioId, createdAt])
}

model Evaluacion {
  id          String     @id @default(uuid())
  titulo      String
  moduloId    String?    @unique
  modulo      Modulo?    @relation(fields: [moduloId], references: [id])
  cursoId     String? // null si es de módulo, presente si es final
  esFinal     Boolean    @default(false)
  intentosMax Int        @default(3)
  notaMinima  Float      @default(70)
  preguntas   Pregunta[]
  intentos    Intento[]
}

model Pregunta {
  id           String       @id @default(uuid())
  texto        String
  tipo         TipoPregunta
  orden        Int
  evaluacionId String
  evaluacion   Evaluacion   @relation(fields: [evaluacionId], references: [id])
  opciones     Opcion[]
}

model Opcion {
  id         String   @id @default(uuid())
  texto      String
  esCorrecta Boolean  @default(false)
  preguntaId String
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id])
}

model Inscripcion {
  id               String    @id @default(uuid())
  usuarioId        String
  cursoId          String
  fechaInscripcion DateTime  @default(now())
  completado       Boolean   @default(false)
  fechaCompletado  DateTime?
  usuario          Usuario   @relation(fields: [usuarioId], references: [id])
  curso            Curso     @relation(fields: [cursoId], references: [id])

  @@unique([usuarioId, cursoId])
  @@index([usuarioId])
}

model Progreso {
  id              String    @id @default(uuid())
  usuarioId       String
  leccionId       String
  completada      Boolean   @default(false)
  fechaCompletado DateTime?
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  leccion         Leccion   @relation(fields: [leccionId], references: [id])

  @@unique([usuarioId, leccionId])
  @@index([usuarioId])
}

model NotaLeccion {
  id        String   @id @default(uuid())
  usuarioId String
  leccionId String
  texto     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  leccion   Leccion  @relation(fields: [leccionId], references: [id])

  @@unique([usuarioId, leccionId])
}

model Intento {
  id           String     @id @default(uuid())
  usuarioId    String
  evaluacionId String
  numero       Int // 1, 2 o 3
  nota         Float
  aprobado     Boolean
  fechaIntento DateTime   @default(now())
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id])
}

model ComentarioLeccion {
  id        String   @id @default(uuid())
  texto     String
  usuarioId String
  leccionId String
  createdAt DateTime @default(now())
  leccion   Leccion  @relation(fields: [leccionId], references: [id])
}

model Logro {
  id          String         @id @default(uuid())
  nombre      String         @unique
  descripcion String
  icono       String // emoji o URL
  tipo        String // 'curso' | 'racha' | 'social' | 'evaluacion'
  condicion   String // descripción de cómo se desbloquea
  usuarios    LogroUsuario[]
}

model LogroUsuario {
  usuarioId     String
  logroId       String
  fechaObtenido DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  logro         Logro    @relation(fields: [logroId], references: [id])

  @@id([usuarioId, logroId])
}

model Certificado {
  id           String   @id @default(uuid())
  usuarioId    String
  // cursoId nullable + cursoTitulo snapshot: un certificado emitido es un hecho
  // histórico. Si se borra el curso, el FK queda en NULL (SetNull) pero el título
  // queda congelado, así el certificado se preserva en vez de desaparecer.
  cursoId      String?
  cursoTitulo  String   @default("")
  codigoVerif  String   @unique @default(uuid())
  fechaEmision DateTime @default(now())
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  curso        Curso?   @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, cursoId])
}
