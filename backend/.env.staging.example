# Staging-only backend configuration. Never commit .env.staging.
DATABASE_URL=postgresql://staging-user:staging-password@staging-host:5432/titi_staging
NEO4J_URI=neo4j+s://staging-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
JWT_SECRET=replace-with-random-staging-secret
PORT=3001
FRONTEND_URL=https://staging-frontend.example.com

RAG_ENABLED=true
RAG_COURSE_IDS=*
RAG_ALLOWED_USER_EMAIL=student@gmail.com
EMBEDDING_API_URL=https://titi-embedding-staging.example.com
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=google/embeddinggemma-300M
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=local
EMBEDDING_TIMEOUT_MS=120000
EMBEDDING_MAX_RETRIES=1
RAG_CHAT_MODE=gateway
RAG_CHAT_RATE_LIMIT_PER_MINUTE=5
RAG_CHAT_DAILY_QUOTA=30
RAG_CHAT_TIMEOUT_MS=30000
RAG_PRINCIPAL_SALT=replace-with-random-staging-salt
AI_GATEWAY_URL=https://titi-ai-gateway-staging.example.com
AI_GATEWAY_TOKEN=replace-me
