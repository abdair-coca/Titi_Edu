# ─── PostgreSQL (Prisma) ───────────────────────────────────────────────
# Local: postgresql://USER:PASSWORD@localhost:5432/titi
# Prod: DATABASE_URL de Neon (Postgres serverless, gratis, con pgvector).
DATABASE_URL="postgresql://user:password@localhost:5432/titi"

# ─── Neo4j (Aura o local) ──────────────────────────────────────────────
NEO4J_URI=neo4j+s://XXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu_password_de_aura

# ─── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=neosocial_secret_2026_cambiar_en_produccion

# Authoring API: JWT authoring remains available; this flag enables service-token access.
AUTHORING_API_ENABLED=false
# Dedicated HMAC key for 10-minute publication confirmations. Never reuse JWT_SECRET in production.
AUTHORING_CONFIRMATION_SECRET=replace_with_a_distinct_random_secret
# Optional comma-separated exact host allowlist. Defaults to YouTube and Vimeo hosts.
AUTHORING_VIDEO_HOSTS=youtube.com,www.youtube.com,youtu.be,vimeo.com,www.vimeo.com,player.vimeo.com

# ─── Servidor ──────────────────────────────────────────────────────────
PORT=3001

# Orígenes adicionales permitidos por CORS (separados por coma).
# Localhost siempre está permitido; aquí va el dominio de producción.
# Admite varias URLs para incluir previews de Vercel:
#   FRONTEND_URL=https://titiedu.vercel.app,https://titiedu-git-dev.vercel.app
FRONTEND_URL=https://titiedu.vercel.app

# ─── Cloudinary (storage de imágenes/materiales) ───────────────────────
# Sin estas credenciales, las subidas caen a disco local (solo dev).
# En prod son obligatorias (Render tiene filesystem efímero).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Seed (opcional) ───────────────────────────────────────────────────
# Password de las cuentas demo que crea `npm run seed`.
SEED_PASSWORD=titi1234
