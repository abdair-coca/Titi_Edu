# ─── PostgreSQL (Prisma) ───────────────────────────────────────────────
# Local: postgresql://USER:PASSWORD@localhost:5432/titi
# Prod: DATABASE_URL de Neon (Postgres serverless, gratis, con pgvector).
DATABASE_URL="postgresql://user:password@localhost:5432/titi"

# ─── Neo4j (Aura o local) ──────────────────────────────────────────────
NEO4J_URI=neo4j+s://XXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu_password_de_aura

# ─── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=neosocial_secret_2026_cambiar_en_produccion

# Authoring API: JWT authoring remains available; this flag enables service-token access.
AUTHORING_API_ENABLED=false
# Dedicated HMAC key for 10-minute publication confirmations. Never reuse JWT_SECRET in production.
AUTHORING_CONFIRMATION_SECRET=replace_with_a_distinct_random_secret
# Optional comma-separated exact host allowlist. Defaults to YouTube and Vimeo hosts.
AUTHORING_VIDEO_HOSTS=youtube.com,www.youtube.com,youtu.be,vimeo.com,www.vimeo.com,player.vimeo.com

# ─── Servidor ──────────────────────────────────────────────────────────
PORT=3001

# Orígenes adicionales permitidos por CORS (separados por coma).
# Localhost siempre está permitido; aquí va el dominio de producción.
# Admite varias URLs para incluir previews de Vercel:
#   FRONTEND_URL=https://titiedu.vercel.app,https://titiedu-git-dev.vercel.app
FRONTEND_URL=https://titiedu.vercel.app

# ─── Cloudinary (storage de imágenes/materiales) ───────────────────────
# Sin estas credenciales, las subidas caen a disco local (solo dev).
# En prod son obligatorias (Render tiene filesystem efímero).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Seed (opcional) ───────────────────────────────────────────────────
# Password de las cuentas demo que crea `npm run seed`.
SEED_PASSWORD=titi1234

# ─── Tutor RAG (Fase 1) ───────────────────────────────────────────────
# Activación global + lista opcional de cursos piloto separados por coma.
RAG_ENABLED=false
# Kill switch independiente para generación; indexado/readiness pueden operar con false.
RAG_CHAT_ENABLED=false
# Producción BYOK: curso piloto exacto. No usar *.
RAG_COURSE_IDS=bceba93d-d954-4bc9-abf7-db865b1df8ff
# canary: correos exactos; course_access: todos los usuarios autorizados del curso.
RAG_AUDIENCE_MODE=canary
RAG_ALLOWED_USER_EMAIL=
# Cada usuario registra su propia API key Groq; no existe fallback global.
RAG_CREDENTIAL_MODE=user_required
# Keyring AES-256-GCM. CURRENT contiene el sufijo activo (ej. V1); V1 contiene
# 32 bytes aleatorios codificados según la implementación. Secretos solo en Render.
AI_CREDENTIAL_KEY_CURRENT=V1
AI_CREDENTIAL_KEY_V1=
# El modelo y la dimensión deben mantenerse estables hasta reindexar todo.
# Local EmbeddingGemma service. Keep this provider for local development.
EMBEDDING_API_URL=http://127.0.0.1:8001
EMBEDDING_API_KEY=local-dev-key
EMBEDDING_MODEL=google/embeddinggemma-300M
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=local
# Local model startup can be slow; retry transient provider failures once.
EMBEDDING_TIMEOUT_MS=120000
EMBEDDING_MAX_RETRIES=1
# Cloudflare Workers AI administrado para embeddings. Token solo en backend.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Cloudflare AI Gateway administrado; Authorization de Groq llega desde BYOK por request.
AI_PROVIDER_ROUTE=cloudflare_gateway
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
# El tutor usa exclusivamente openai/gpt-oss-20b; no es configurable.
RAG_CHAT_RATE_LIMIT_PER_MINUTE=5
RAG_CHAT_DAILY_QUOTA=30
RAG_CHAT_TIMEOUT_MS=30000
RAG_INDEX_TRANSACTION_MAX_WAIT_MS=10000
RAG_INDEX_TRANSACTION_TIMEOUT_MS=30000
RAG_PRINCIPAL_SALT=

# Solo desarrollo local o rollback legacy. No son requisitos de producción BYOK.
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
RAG_CHAT_MODE=direct
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
